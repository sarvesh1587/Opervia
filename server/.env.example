NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://opervia:opervia@localhost:5432/opervia
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-0000000000
SESSION_TTL_HOURS=8
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# lax works when the web app and API share a site (same domain, or proxied /api). Use none (+ HTTPS) for cross-site.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true          # defaults to true in production
# TRUST_PROXY=true            # behind a load balancer / reverse proxy
DEMO_LOGIN_ENABLED=true       # one-click demo roles on the sign-in page
ALLOW_DEMO_RESET=false        # set true (or use npm run db:reset-demo) to re-seed the demo workspace
# Optional. Without it the assistant answers in offline mode from the same tools.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=15000
