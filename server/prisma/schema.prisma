// Opervia — multi-tenant schema. Every business record carries businessId and every
// query is scoped by it, so changing an id in a URL can never reach another workspace.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  OPENING
  PURCHASE_RECEIPT
  SALE
  SALE_CANCELLED
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  city               String?
  currency           String   @default("INR")
  taxRate            Decimal  @default(18) @db.Decimal(5, 2)
  taxLabel           String   @default("GST")
  paymentTermsDays   Int      @default(15)
  isDemo             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users          User[]
  categories     Category[]
  products       Product[]
  suppliers      Supplier[]
  customers      Customer[]
  movements      InventoryMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  auditLogs      AuditLog[]
  counters       Counter[]
  idempotency    IdempotencyKey[]
}

model User {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STAFF)
  active       Boolean   @default(true)
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs           AuditLog[]
  createdSalesOrders  SalesOrder[]    @relation("SalesOrderCreatedBy")
  createdPurchaseOrds PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  movements           InventoryMovement[]
  payments            Payment[]

  @@index([businessId])
}

model Category {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
  products   Product[]

  @@unique([businessId, name])
}

model Product {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  description    String?
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  costPrice      Decimal       @db.Decimal(12, 2)
  sellingPrice   Decimal       @db.Decimal(12, 2)
  stockQty       Int           @default(0)
  reorderLevel   Int           @default(0)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  invoiceItems       InvoiceItem[]

  @@unique([businessId, sku])
  @@index([businessId, status, name])
  @@index([businessId, categoryId])
  @@index([businessId, supplierId])
}

model Supplier {
  id           String      @id @default(cuid())
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?
  email        String?
  phone        String?
  address      String?
  gstin        String?
  status       PartyStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@unique([businessId, name])
  @@index([businessId, status])
}

model Customer {
  id          String      @id @default(cuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  gstin       String?
  status      PartyStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@unique([businessId, name])
  @@index([businessId, status])
}

model InventoryMovement {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        MovementType
  quantity    Int
  balanceAfter Int
  reference   String?
  note        String?
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([businessId, productId, createdAt])
  @@index([businessId, type, createdAt])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  businessId       String
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number           String
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status           PurchaseOrderStatus @default(DRAFT)
  subtotal         Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal             @default(0) @db.Decimal(14, 2)
  total            Decimal             @default(0) @db.Decimal(14, 2)
  notes            String?
  expectedAt       DateTime?
  orderedAt        DateTime?
  receivedAt       DateTime?
  cancelledAt      DateTime?
  createdById      String?
  createdBy        User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  items            PurchaseOrderItem[]

  @@unique([businessId, number])
  @@index([businessId, status, createdAt])
  @@index([businessId, supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int
  receivedQty     Int           @default(0)
  unitCost        Decimal       @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(14, 2)

  @@index([purchaseOrderId])
  @@index([productId])
}

model SalesOrder {
  id           String           @id @default(cuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number       String
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status       SalesOrderStatus @default(DRAFT)
  subtotal     Decimal          @default(0) @db.Decimal(14, 2)
  discount     Decimal          @default(0) @db.Decimal(14, 2)
  taxRate      Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal          @default(0) @db.Decimal(14, 2)
  total        Decimal          @default(0) @db.Decimal(14, 2)
  notes        String?
  stockApplied Boolean          @default(false)
  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdById  String?
  createdBy    User?            @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  items        SalesOrderItem[]
  invoice      Invoice?

  @@unique([businessId, number])
  @@index([businessId, status, confirmedAt])
  @@index([businessId, customerId])
  @@index([businessId, createdAt])
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  unitCost     Decimal    @db.Decimal(12, 2)
  lineTotal    Decimal    @db.Decimal(14, 2)

  @@index([salesOrderId])
  @@index([productId])
}

model Invoice {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number       String
  salesOrderId String        @unique
  salesOrder   SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status       InvoiceStatus @default(UNPAID)
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  subtotal     Decimal       @db.Decimal(14, 2)
  discount     Decimal       @db.Decimal(14, 2)
  taxRate      Decimal       @db.Decimal(5, 2)
  taxAmount    Decimal       @db.Decimal(14, 2)
  total        Decimal       @db.Decimal(14, 2)
  amountPaid   Decimal       @default(0) @db.Decimal(14, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([businessId, number])
  @@index([businessId, status, dueDate])
  @@index([businessId, customerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  description String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
}

model Payment {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount     Decimal       @db.Decimal(14, 2)
  method     PaymentMethod
  reference  String?
  isDemo     Boolean       @default(true)
  paidAt     DateTime      @default(now())
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@index([businessId, paidAt])
  @@index([invoiceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, entity, entityId])
}

model Counter {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key        String
  value      Int      @default(0)

  @@id([businessId, key])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key          String
  route        String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([businessId, key, route])
}
