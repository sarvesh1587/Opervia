# API base. Leave as /api when the frontend proxies to the backend (Vite dev server, Docker nginx, Vercel rewrites).
VITE_API_URL=/api

# true serves the built-in demo dataset without a backend (used for the static preview build only).
VITE_DEMO_DATA=false

# 'memory' only for the single-file preview build (npm run build:preview)
VITE_ROUTER=browser
